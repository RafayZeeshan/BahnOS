DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments

# Optional. Without a key the app replays recorded agent runs. With one, "Ask the agent" and new runs go live.
# CLAUDE_API_KEY is accepted too, and the repo-root .env is read as a fallback.
ANTHROPIC_API_KEY=
# Optional. An OpenRouter key is used instead of the Anthropic one when set (same Claude model, via openrouter.ai).
OPENROUTER_API_KEY=
# Optional. Defaults to claude-sonnet-5-5 (anthropic/claude-sonnet-5.5 on OpenRouter).
AGENT_MODEL=
